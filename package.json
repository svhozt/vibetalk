{
  "name": "vibetalk",
  "version": "1.0.0",
  "description": "Real-time voice dictation from your terminal \u2014 speak and it types wherever your cursor is. Fully local streaming speech recognition, no API key, no cloud.",
  "type": "module",
  "bin": {
    "vibetalk": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:models": "VIBETALK_MODEL_TESTS=1 node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "voice",
    "dictation",
    "speech-to-text",
    "streaming",
    "real-time",
    "asr",
    "sherpa-onnx",
    "local-ai",
    "offline",
    "cli",
    "typing",
    "transcription",
    "voice-coding",
    "accessibility",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "Sahan Nishshanka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svhozt/vibetalk.git"
  },
  "homepage": "https://github.com/svhozt/vibetalk#readme",
  "bugs": {
    "url": "https://github.com/svhozt/vibetalk/issues"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "^1.2.9",
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "sherpa-onnx-node": "^2.0.3"
  },
  "optionalDependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "readme.md",
    "LICENSE"
  ]
}
